{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "dracula",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "low"
  },
  "animations": true,
  "mouse": true,
  "keybinds": {
    "quota-window.show": "<leader>o"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "tabs": {
    "mode": "off"
  }
}
