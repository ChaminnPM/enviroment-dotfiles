# Tema canonico del entorno: Dracula + JetBrainsMono Nerd Font.
# Fuente unica de verdad: los scripts cargan este archivo y generan la config de
# cada herramienta. No duplicar estos valores en otros archivos.
# Overrides permitidos por entorno: THEME_ENV_FILE, THEME_NERD_VERSION,
# THEME_NERD_REPO_URL, THEME_WSL_*.

THEME_NAME=dracula

# --- paleta Dracula -------------------------------------------------------
THEME_BG='#282a36'
THEME_BLACK_DARKER='#21222c'
THEME_CURRENT='#44475a'
THEME_FG='#f8f8f2'
THEME_COMMENT='#6272a4'
THEME_RED='#ff5555'
THEME_GREEN='#50fa7b'
THEME_ORANGE='#ffb86c'
THEME_YELLOW='#f1fa8c'
THEME_PURPLE='#bd93f9'
THEME_PINK='#ff79c6'
THEME_CYAN='#8be9fd'

# Variantes "bright" (las que ya usaba alacritty.toml; se conservan).
THEME_BRIGHT_BLACK='#6272a4'
THEME_BRIGHT_RED='#ff6e6e'
THEME_BRIGHT_GREEN='#69ff94'
THEME_BRIGHT_YELLOW='#ffffa5'
THEME_BRIGHT_BLUE='#d6acff'
THEME_BRIGHT_MAGENTA='#ff92df'
THEME_BRIGHT_CYAN='#a4ffff'
THEME_BRIGHT_WHITE='#ffffff'

# --- tipografia -----------------------------------------------------------
THEME_FONT_FAMILY='JetBrainsMono Nerd Font'
THEME_FONT_SIZE='10.0'
THEME_NERD_VERSION='v3.4.0'
THEME_NERD_REPO_URL='https://github.com/ryanoasis/nerd-fonts'
THEME_NERD_ASSET='JetBrainsMono.zip'

# --- herramientas ---------------------------------------------------------
# oh-my-bash no trae un tema "dracula"; "vscode" es el mas cercano y usa
# glifos Nerd. El color del prompt se completa con el snippet de theme.sh.
THEME_OMB_THEME='vscode'
# Prompt de Windows: config/oh-my-posh/<THEME_OMP_THEME>.omp.json. "vscode" es
# el puerto fiel del tema de oh-my-bash (misma forma en las dos capas:
# "usuario -> ruta (rama) $"). Alternativa incluida: "dracula" (powerline).
THEME_OMP_THEME='vscode'

# Dracula en 256 colores (aproximaciones para eza/ls/fzf).
THEME_EZA_COLORS='di=38;5;141:ln=38;5;117:ex=1;38;5;84:pi=38;5;62:so=38;5;213:bd=38;5;62:cd=38;5;62:or=38;5;203:mi=38;5;203:*.md=38;5;228:*.sh=38;5;84:*.py=38;5;228:*.json=38;5;228'
THEME_FZF_OPTS='--color=fg:#f8f8f2,bg:#282a36,hl:#bd93f9,fg+:#f8f8f2,bg+:#44475a,hl+:#bd93f9,info:#8be9fd,prompt:#ff79c6,pointer:#bd93f9,marker:#50fa7b,spinner:#bd93f9,header:#6272a4,border:#6272a4'
